<Project Sdk="Microsoft.NET.Sdk">

  <!--
    TargetFramework, LangVersion, Nullable, ImplicitUsings and analyzer settings
    come from Directory.Build.props. This is a runnable project rather than a
    library, so it opts out of XML doc generation and packing.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>HalHeinrich.Numerics.Collatz.Experiments</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Collatz\Collatz.csproj" />
  </ItemGroup>

</Project>
